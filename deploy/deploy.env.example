# deploy/deploy.env — local, gitignored deploy config.
# Copy to deploy/deploy.env and set your server's SSH host.
#
#   cp deploy/deploy.env.example deploy/deploy.env
#   $EDITOR deploy/deploy.env
#
# Only MEETINGNOTES_HOST is required; the rest default to this project's
# standard layout (see deploy/deploy.sh).

MEETINGNOTES_HOST=yourserver          # SSH hostname or IP

# Optional overrides (defaults shown):
# MEETINGNOTES_REMOTE_DIR=/opt/nbmeetingnotes
# MEETINGNOTES_SERVICE=meetingnotes
# MEETINGNOTES_USER=nthmost
# MEETINGNOTES_LOG_DIR=/var/log/nbarchive
# MEETINGNOTES_DATA_DIR=/var/lib/nbmeetingnotes
